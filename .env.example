# Optional Firebase App Check reCAPTCHA v3 Site Key (public client key — never place private secrets here)
# Configure App Check in Firebase Console (Build > App Check) using free Google reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=""

# Optional Firebase App Check debug token for local development only (leave blank in production)
VITE_APPCHECK_DEBUG_TOKEN=""
